# Puerto en el que corre la aplicación (Hostinger lo asigna automáticamente en producción)
PORT=3000

# Número de WhatsApp para recibir solicitudes (incluir código de país sin '+')
WHATSAPP_NUMBER=573164734660

# Correo de soporte
SUPPORT_EMAIL=care@caretechservices.com

# URL de la Demo o Dashboard de Care Loyalty
DEMO_URL=https://www.caretechapps.com/dashboard

# URL Base de la aplicación (para redirecciones de pago de Binance Pay/Wompi y Webhooks)
APP_BASE_URL=https://caretechservices.com/loyalty

# ==========================================
# 1. CONFIGURACIÓN BINANCE PAY (Merchant API)
# ==========================================
# Obtén tus credenciales en: https://merchant.binance.com
BINANCE_PAY_API_KEY=
BINANCE_PAY_SECRET_KEY=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com

# ==========================================
# 2. CONFIGURACIÓN WOMPI (PSE, Bancolombia, Nequi, Tarjetas)
# ==========================================
# Obtén tus credenciales en: https://comercios.wompi.co
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=

# ==========================================
# 3. CONFIGURACIÓN PAYPAL (Checkout REST API)
# ==========================================
# Obtén tus credenciales (Client ID & Secret) en:
# https://www.paypal.com/mep/merchantapps/setup/checkout/apicredentials
# o en https://developer.paypal.com/dashboard/applications
# Modo: 'sandbox' para pruebas, 'live' para producción en vivo
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# 4. HOSTINGER SSH (respaldo y despliegue). Preferir clave SSH; nunca escribir la contraseña en scripts.
HOSTINGER_HOST=
HOSTINGER_PORT=65002
HOSTINGER_USER=
HOSTINGER_SSH_KEY=
HOSTINGER_PASSWORD=
