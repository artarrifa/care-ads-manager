# ==============================================================================
# Solitario Care PWA - Apache Configuration (.htaccess)
# ==============================================================================

# 1. Custom MIME Types for PWA & Game Engines (Cocos / WebAssembly)
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/wasm .wasm
  AddType application/javascript .js .mjs
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType audio/ogg .ogg
  AddType audio/mpeg .mp3
</IfModule>

# 2. Security Headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 3. Cache-Control Policies
<IfModule mod_headers.c>
  # Critical PWA Lifecycle files must never be cached aggressively by browsers
  <FilesMatch "(sw\.js|register-pwa\.js|manifest\.webmanifest|index\.html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Service Worker Header to restrict maximum scope
  <Files "sw.js">
    Header set Service-Worker-Allowed "/games/solitario/"
  </Files>
</IfModule>

# 4. Long-term caching for static game assets (Images, Fonts, Audio, WASM)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType audio/ogg "access plus 1 year"
  ExpiresByType audio/mpeg "access plus 1 year"
</IfModule>

# 5. Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json application/manifest+json application/wasm image/svg+xml
</IfModule>
